# Copy to .env and fill in. .env is gitignored.
#
# An Anthropic API key, created at platform.claude.com. Only --backend anthropic
# needs it; every other part of the project, including all of Arm 1 and both
# no-model baselines, runs without it.
ANTHROPIC_API_KEY=sk-ant-...

# Required for identity-linked keys (the default when you create a key against
# your own account). Without it the API returns:
#   "anthropic-workspace-id is required when authenticating with an
#    identity-linked API key"
# The Console shows it when the key is created. Not a secret.
ANTHROPIC_WORKSPACE_ID=wrkspc_...
